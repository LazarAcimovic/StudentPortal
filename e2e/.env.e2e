# ─── e2e environment ────────────────────────────────────────────────────────
# Loaded by globalSetup (via dotenv) and passed to docker-compose (--env-file) and
# to the spawned backend. Local-only values; the secret gates the /api/__test__ surface
# and is NOT a production credential. See e2e/README.md.

# Dockerized Postgres (pinned postgres:17)
# 54329 is deliberately outside the Windows WinNAT reserved ranges (e.g. 55400–55499).
E2E_POSTGRES_PORT=54329
E2E_POSTGRES_DB=studentportal_e2e
E2E_POSTGRES_USER=e2e
E2E_POSTGRES_PASSWORD=e2e

# Backend (started by globalSetup in the e2e environment)
#   https endpoint is what the frontend proxy and the browser session use;
#   http endpoint is a cert-free target for readiness polling.
E2E_BACKEND_URL=https://localhost:7253
E2E_BACKEND_HTTP_URL=http://localhost:5012
E2E_BACKEND_CONNECTION=Host=localhost;Port=54329;Database=studentportal_e2e;Username=e2e;Password=e2e

# Frontend (vite dev server; proxies /api to E2E_BACKEND_URL per vite.config.ts)
E2E_FRONTEND_URL=http://localhost:5173

# JWT signing (≥64 bytes for HMAC-SHA512). Local test value only.
E2E_JWT_KEY=e2e-signing-key-with-at-least-sixty-four-bytes-of-entropy-xxxxxxxxxx
E2E_JWT_ISSUER=https://localhost:7253/
E2E_JWT_AUDIENCE=https://localhost:7253

# Test-mode guard — layer 4 (per-build secret header). Must match the value the
# backend is started with. Rotate per environment; never reuse in Production.
E2E_TEST_SECRET=local-e2e-secret-change-me

# Seeded cast (seed.sql) — every seeded user shares this password.
E2E_PASSWORD=Password123!
E2E_ADMIN_EMAIL=admin@uni.edu
E2E_PROFESSOR_EMAIL=john.smith@uni.edu
E2E_STUDENT_EMAIL=sarah.williams@student.edu
