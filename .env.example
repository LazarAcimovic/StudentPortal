# Production environment variables for Render deployment.
# Copy this file, fill in real values, and set them as Render environment variables.
# Never commit the file with real values.

ASPNETCORE_ENVIRONMENT=Production
JwtConfig__Key=replace-with-a-base64-encoded-random-key-of-at-least-32-bytes
JwtConfig__Issuer=https://your-backend.onrender.com/
JwtConfig__Audience=https://your-frontend.onrender.com
JwtConfig__RefreshTokenValidityDays=7
ConnectionStrings__DefaultConnection=Host=your-db-host;Port=5432;Database=StudentPortal;Username=your-db-user;Password=your-db-password
Cors__Origins__0=https://your-frontend.onrender.com
Cors__Origins__1=https://your-custom-domain.com
