<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>Euroleague</DataSourceReference>
      <DataSetParameters>
        <DataSetParameter Name="@player_name_clean">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>Object</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="@season_name">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>Object</rd:DbType>
        </DataSetParameter>
      </DataSetParameters>
      <CommandText>SELECT
    dq.quarter,
    AVG(fps.points) AS average_points,
    AVG(fps.assists) AS average_assists
FROM
    Fact_PlayerGame_Stats fps
JOIN
    Dim_Quarter dq ON fps.quarter_id = dq.quarter_id
JOIN
    Dim_Player dp ON fps.player_id = dp.player_id
JOIN
    Dim_Season ds ON fps.season_id = ds.season_id
WHERE
    dp.player_name_clean = @player_name_clean
    AND ds.season_name = @season_name
GROUP BY
    dq.quarter
ORDER BY
    dq.quarter ASC;</CommandText>
    </Query>
    <Fields>
      <Field Name="quarter">
        <DataField>quarter</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="average_points">
        <DataField>average_points</DataField>
        <rd:TypeName>System.Int32</rd:TypeName>
      </Field>
      <Field Name="average_assists">
        <DataField>average_assists</DataField>
        <rd:TypeName>System.Int32</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>