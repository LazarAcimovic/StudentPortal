  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>Euroleague</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>3703594c-1ae3-4f09-b3d6-2b42958a45af</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="SeasonList">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT DISTINCT
    T2.season_name
FROM
    Fact_PlayerGame_Stats AS T1
JOIN
    Dim_Season AS T2 ON T1.season_id = T2.season_id
JOIN
    Dim_Quarter AS T3 ON T1.quarter_id = T3.quarter_id
JOIN
    Dim_Player AS T4 ON T1.player_id = T4.player_id
ORDER BY
    T2.season_name DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="season_name">
          <DataField>season_name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PlayerList">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@season_name">
            <Value>=Parameters!season_name.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT
    T4.player_name_clean
FROM
    Fact_PlayerGame_Stats AS T1
JOIN
    Dim_Season AS T2 ON T1.season_id = T2.season_id
JOIN
    Dim_Quarter AS T3 ON T1.quarter_id = T3.quarter_id
JOIN
    Dim_Player AS T4 ON T1.player_id = T4.player_id
WHERE
    T2.season_name = @season_name
ORDER BY
    T4.player_name_clean ASC;</CommandText>
      </Query>
      <Fields>
        <Field Name="player_name_clean">
          <DataField>player_name_clean</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <SharedDataSet>
        <SharedDataSetReference>AssistsPointsByQuarter</SharedDataSetReference>
        <QueryParameters>
          <QueryParameter Name="@player_name_clean">
            <Value>=Parameters!player_name_clean.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@season_name">
            <Value>=Parameters!season_name.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </SharedDataSet>
      <Fields>
        <Field Name="quarter">
          <DataField>quarter</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="average_points">
          <DataField>average_points</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="average_assists">
          <DataField>average_assists</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
