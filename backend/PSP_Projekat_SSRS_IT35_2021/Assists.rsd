<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>Euroleague</DataSourceReference>
      <CommandText>select player_name_clean as player_name,team_name_clean as team_name, game_name, stadium_clean as stadium_name, sum(assists) as AssistsMade
from Fact_PlayerGame_Stats fps 
	join dim_team dt on fps.team_id = dt.team_id
	join dim_player dp on fps.player_id = dp.player_id
	join dim_game dg on fps.game_id = dg.game_id
	join Dim_Stadium ds on fps.stadium_id = ds.stadium_id
	group by game_name, player_name_clean, team_name_clean, stadium_clean</CommandText>
    </Query>
    <Fields>
      <Field Name="player_name">
        <DataField>player_name</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="team_name">
        <DataField>team_name</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="game_name">
        <DataField>game_name</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="stadium_name">
        <DataField>stadium_name</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="AssistsMade">
        <DataField>AssistsMade</DataField>
        <rd:TypeName>System.Int32</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>