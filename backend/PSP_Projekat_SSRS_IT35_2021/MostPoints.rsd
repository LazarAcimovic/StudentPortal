<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>Euroleague</DataSourceReference>
      <CommandText>WITH RankedPlayers AS (
    SELECT
        dd.year AS competition_year,
        dg.game_name,
        dph.phase_name_clean AS phase_name,
        dp.player_name_clean AS player_name,
        fps.points,
        RANK() OVER (PARTITION BY dd.year, dg.game_name, dph.phase_name_clean ORDER BY fps.points DESC) AS player_rank
    FROM
        Fact_PlayerGame_Stats fps
    JOIN
        Dim_Phase dph ON fps.phase_id = dph.phase_id
    JOIN
        Dim_Player dp ON fps.player_id = dp.player_id
    JOIN
        Dim_Date dd ON fps.date_id = dd.date_key
    JOIN
        Dim_Game dg ON fps.game_id = dg.game_id
)
SELECT
    competition_year,
    game_name,
    phase_name,
    player_name,
    points
FROM
    RankedPlayers
WHERE
    player_rank &lt;= 3
ORDER BY
    competition_year DESC,
    game_name ASC,
    phase_name ASC,
    points DESC;</CommandText>
    </Query>
    <Fields>
      <Field Name="competition_year">
        <DataField>competition_year</DataField>
        <rd:TypeName>System.Int16</rd:TypeName>
      </Field>
      <Field Name="game_name">
        <DataField>game_name</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="phase_name">
        <DataField>phase_name</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="player_name">
        <DataField>player_name</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="points">
        <DataField>points</DataField>
        <rd:TypeName>System.Int32</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>